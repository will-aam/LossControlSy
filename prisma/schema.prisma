// Configuração do Cliente e Banco de Dados
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- ENUMS (Opções fixas do sistema) ---

enum UserRole {
  dono
  gestor
  fiscal
  funcionario
}

enum EventoStatus {
  rascunho
  enviado
  aprovado
  rejeitado
  exportado
}

enum ItemUnidade {
  UN
  KG
  CX
  L
}

// --- MODELOS (Tabelas) ---

// Usuários do Sistema (Dono, Gerente, etc.)
model User {
  id           String   @id @default(uuid())
  nome         String
  email        String   @unique
  passwordHash String // Senha criptografada
  role         UserRole @default(funcionario)
  avatarUrl    String?
  
  // Controle de Acesso
  ativo        Boolean  @default(true) // Permite bloquear acesso sem deletar dados

  // Hierarquia (Multi-tenancy)
  ownerId      String?  // Se for null, é um Dono independente. Se tiver ID, pertence a esse Dono.
  owner        User?    @relation("TeamHierarchy", fields: [ownerId], references: [id])
  team         User[]   @relation("TeamHierarchy")

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relacionamentos Inversos (Ações do usuário)
  eventosCriados   Evento[]     @relation("CriadoPor")
  eventosAprovados Evento[]     @relation("AprovadoPor")
  notasFiscais     NotaFiscal[] @relation("UploadedBy")
  evidencias       Evidencia[]  @relation("UploadedBy")
  Configuracao     Configuracao[] 

  // Relacionamentos Multi-tenant (Dados que pertencem à loja/dono)
  categoriasLoja   Categoria[]  @relation("CategoriaDono")
  itensLoja        Item[]       @relation("ItemDono")
  eventosLoja      Evento[]     @relation("EventoDono")
  evidenciasLoja   Evidencia[]  @relation("EvidenciaDono")
  notasLoja        NotaFiscal[] @relation("NotaDono")
  motivosLoja      Motivo[]     @relation("MotivoDono")
  subgruposLoja    Subgrupo[]   @relation("SubgrupoDono")
  vendasLoja       VendaDiaria[] @relation("VendaDono")
  nfeComprasLoja   NFeCompra[]  @relation("NFeCompraDono")

  @@map("users")
}

// Categorias de Produtos
model Categoria {
  id        String   @id @default(uuid())
  nome      String   // Removido o @unique simples
  descricao String?
  status    String   @default("ativa") // ativa, inativa
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId   String
  owner     User     @relation("CategoriaDono", fields: [ownerId], references: [id])

  items Item[]
  subgrupos Subgrupo[]

  @@unique([nome, ownerId]) // O nome agora é único apenas DENTRO da mesma loja
  @@map("categorias")
}

// Itens (Produtos)
model Item {
  id            String      @id @default(uuid())
  codigoInterno String      // Removido o @unique simples
  codigoBarras  String?
  nome          String
  unidade       ItemUnidade @default(UN)
  custo         Decimal     @db.Decimal(10, 2)
  custoMedio    Decimal     @default(0) @db.Decimal(10, 2)
  precoVenda    Decimal     @db.Decimal(10, 2)
  imagemUrl     String?
  status        String      @default("ativo") // ativo, inativo
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  categoriaId String?
  categoria   Categoria? @relation(fields: [categoriaId], references: [id])

  subgrupoId  String?
  subgrupo    Subgrupo?  @relation(fields: [subgrupoId], references: [id])

  ownerId     String
  owner       User   @relation("ItemDono", fields: [ownerId], references: [id])

  eventos    Evento[]
  vendaItens VendaItem[]
  fornecedores ItemFornecedor[]
  nfeCompraItens NFeCompraItem[]

  @@unique([codigoInterno, ownerId]) // Código é único apenas DENTRO da mesma loja
  @@map("items")
}

// Eventos de Perda/Quebra
model Evento {
  id        String       @id @default(uuid())
  dataHora  DateTime
  motivo    String?
  status    EventoStatus @default(rascunho)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  quantidade         Decimal @db.Decimal(10, 3)
  unidade            String
  custoSnapshot      Decimal @db.Decimal(10, 2)
  precoVendaSnapshot Decimal @db.Decimal(10, 2)
  nfeEmitida         Boolean @default(false) // NOVO: Flag para marcar se a NFe foi feita

  itemId String? 
  item   Item?   @relation(fields: [itemId], references: [id], onDelete: SetNull)

  criadoPorId String
  criadoPor   User   @relation("CriadoPor", fields: [criadoPorId], references: [id])

  aprovadoPorId String?
  aprovadoPor   User?   @relation("AprovadoPor", fields: [aprovadoPorId], references: [id])

  ownerId       String
  owner         User   @relation("EventoDono", fields: [ownerId], references: [id])

  evidencias   Evidencia[]
  notasFiscais NotaFiscal[]

  @@map("eventos")
}

// Evidências (Fotos)
model Evidencia {
  id         String   @id @default(uuid())
  url        String 
  motivo     String?
  dataUpload DateTime @default(now())

  eventoId String? 
  evento   Evento? @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  userId String 
  user   User   @relation("UploadedBy", fields: [userId], references: [id])

  ownerId  String
  owner    User   @relation("EvidenciaDono", fields: [ownerId], references: [id])

  @@map("evidencias")
}

// Notas Fiscais (XML e PDF)
model NotaFiscal {
  id           String   @id @default(uuid())
  dataUpload   DateTime @default(now())
  pdfUrl       String?
  xmlUrl       String?
  xmlContent   String? @db.Text 
  numero           String?
  serie            String?
  emitente         String?
  cnpjEmitente     String?
  dataEmissao      DateTime? 
  dataReferencia   DateTime? @map("data_referencia") 
  valorTotal       Decimal?  @db.Decimal(12, 2)
  naturezaOperacao String?
  chaveAcesso      String?
  observacoes      String?

  uploadedById String
  uploadedBy   User   @relation("UploadedBy", fields: [uploadedById], references: [id])

  eventoId String? 
  evento   Evento? @relation(fields: [eventoId], references: [id])

  ownerId    String
  owner      User   @relation("NotaDono", fields: [ownerId], references: [id])

  @@map("notas_fiscais")
}

model Motivo {
  id        String   @id @default(uuid())
  nome      String   // Removido o @unique simples
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId   String
  owner     User     @relation("MotivoDono", fields: [ownerId], references: [id])

  @@unique([nome, ownerId]) // Único apenas na mesma loja
  @@map("motivos")
}

// Configurações do Sistema
model Configuracao {
  id                         String  @id @default(uuid())
  empresaNome                String  @default("Minha Empresa")
  exigirFoto                 Boolean @default(false)
  bloquearAprovados          Boolean @default(true)
  limiteDiario               Decimal @default(1000.00) @db.Decimal(10, 2)
  permitirFuncionarioGaleria Boolean @default(false)

  donoId String @unique
  dono   User   @relation(fields: [donoId], references: [id])

  @@map("configuracoes")
}

model Subgrupo {
  id          String   @id @default(uuid())
  codigo      String

  categoriaId String?
  categoria   Categoria? @relation(fields: [categoriaId], references: [id])

  ownerId     String
  owner       User     @relation("SubgrupoDono", fields: [ownerId], references: [id])

  items       Item[]

  @@unique([codigo, ownerId])
  @@map("subgrupos")
}

model VendaDiaria {
  id             String   @id @default(uuid())
  data           DateTime 
  dataImportacao DateTime @default(now())
  
  ownerId        String
  owner          User     @relation("VendaDono", fields: [ownerId], references: [id])

  itens          VendaItem[]

  @@unique([data, ownerId])
  @@map("vendas_diarias")
}

model VendaItem {
  id             String   @id @default(uuid())
  vendaDiariaId  String
  vendaDiaria    VendaDiaria @relation(fields: [vendaDiariaId], references: [id], onDelete: Cascade)
  
  itemId         String
  item           Item     @relation(fields: [itemId], references: [id])
  
  quantidade     Decimal  @db.Decimal(10, 3)
  valorLiquido   Decimal  @db.Decimal(10, 2)
  precoMedio     Decimal  @db.Decimal(10, 2)

  @@map("venda_itens")
}

// ----------------------------------------------------
// Importação de NFe (Custos)
// ----------------------------------------------------

model ItemFornecedor {
  id               String @id @default(uuid())
  codigoFornecedor String // cProd

  itemId           String
  item             Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  createdAt        DateTime @default(now())

  @@unique([itemId, codigoFornecedor])
  @@map("item_fornecedores")
}

model NFeCompra {
  id             String   @id @default(uuid())
  dataImportacao DateTime @default(now())
  
  numero         String?
  emitente       String?
  dataEmissao    DateTime?
  valorTotal     Decimal? @db.Decimal(12, 2)
  xmlContent     String?  @db.Text

  ownerId        String
  owner          User     @relation("NFeCompraDono", fields: [ownerId], references: [id])

  itens          NFeCompraItem[]

  @@map("nfe_compras")
}

model NFeCompraItem {
  id                  String   @id @default(uuid())
  nfeCompraId         String
  nfeCompra           NFeCompra @relation(fields: [nfeCompraId], references: [id], onDelete: Cascade)
  
  codigoFornecedor    String?  // cProd
  descricaoFornecedor String?  // xProd
  unidade             String?  // uCom
  quantidade          Decimal? @db.Decimal(10, 4) // qCom
  valorUnitario       Decimal? @db.Decimal(12, 4) // vUnCom
  valorTotal          Decimal? @db.Decimal(12, 2) // vProd

  itemId              String?
  item                Item?    @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@map("nfe_compra_itens")
}